        "ko": [
          { "start": "00:02", "end": "00:06", "text": "한 권만 자리가 틀어져 있다.", "fadeIn": true, "fadeOut": true },
          { "start": "00:07", "end": "00:11", "text": "표지가 바랬다. 삼 년 전 호다.", "fadeIn": true, "fadeOut": true },
          { "start": "00:14", "end": "00:19", "text": "가운데가 접혀 있다. 여러 번 펼친 자국.", "fadeIn": true, "fadeOut": true },
          { "start": "00:20", "end": "00:25", "text": "누가 같은 페이지를 계속 봤다.", "fadeIn": true, "fadeOut": true },
          { "start": "00:31", "end": "00:36", "text": "마지막 장에 전화번호가 적혀 있다.", "fadeIn": true, "fadeOut": true },
          { "start": "00:37", "end": "00:41", "text": "지워졌다가, 다시 쓰였다.", "fadeIn": true, "fadeOut": true }
        ],
        "en": [
          { "start": "00:02", "end": "00:06", "text": "Only one is out of place.", "fadeIn": true, "fadeOut": true },
          { "start": "00:07", "end": "00:11", "text": "The cover has faded. It is three years old.", "fadeIn": true, "fadeOut": true },
          { "start": "00:14", "end": "00:19", "text": "The middle is creased. Opened many times.", "fadeIn": true, "fadeOut": true },
          { "start": "00:20", "end": "00:25", "text": "Someone kept returning to the same page.", "fadeIn": true, "fadeOut": true },
          { "start": "00:31", "end": "00:36", "text": "A phone number is written on the last page.", "fadeIn": true, "fadeOut": true },
          { "start": "00:37", "end": "00:41", "text": "Erased, then written again.", "fadeIn": true, "fadeOut": true }
